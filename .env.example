# Copy to .env (or .env.local) and fill in. Never commit real values.
# Both values come from Supabase Dashboard -> Project Settings -> API.
# They are embedded in the client bundle at build time (VITE_ prefix), so only
# ever use the public "anon" key here, never the service_role key.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# anon / public API key (access is enforced by Row Level Security)
VITE_SUPABASE_ANON_KEY=
